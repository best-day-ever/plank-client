PLANK: request full-panel content while retaining native fullscreen Spaces.

Pinned input: SDL 3.4.2. This is an opt-in modification of the SDL Cocoa
delegate, using the public NSWindowDelegate content-size callback. Other
windows keep AppKit's proposed size. No display mode or input changes.

--- a/src/video/cocoa/SDL_cocoawindow.m
+++ b/src/video/cocoa/SDL_cocoawindow.m
@@ -1614,6 +1614,23 @@
     }
 }
 
+- (NSSize)window:(NSWindow *)window willUseFullScreenContentSize:(NSSize)proposedSize
+{
+    if (SDL_GetHintBoolean("PLANK_MAC_FULLSCREEN_FULL_DISPLAY", false) && window.screen) {
+        // PLANK's video uses the full panel; only controls avoid the notch.
+        // Keep AppKit's native Space and animation instead of replacing its
+        // window delegate or moving a borderless window above other Spaces.
+        NSSize fullSize = window.screen.frame.size;
+        SDL_Log("PLANK native fullscreen content: proposed=%.0fx%.0f requested=%.0fx%.0f",
+                (double)proposedSize.width, (double)proposedSize.height,
+                (double)fullSize.width, (double)fullSize.height);
+        if (fullSize.width > 0 && fullSize.height > 0) {
+            return fullSize;
+        }
+    }
+    return proposedSize;
+}
+
